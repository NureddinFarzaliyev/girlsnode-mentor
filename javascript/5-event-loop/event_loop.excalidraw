      "isDeleted": false,
      "boundElements": null,
      "updated": 1775366088933,
      "link": null,
      "locked": false,
      "text": "This means that the engine cannot do \nmore than one thing at a time",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This means that the engine cannot do \nmore than one thing at a time",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bE7_K8tx0wFyKEZOYxgna",
      "type": "text",
      "x": 9529.76180342313,
      "y": 781.6374215101939,
      "width": 320.45001220703125,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4u",
      "roundness": null,
      "seed": 131707972,
      "version": 694,
      "versionNonce": 19342588,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775366587020,
      "link": null,
      "locked": false,
      "text": "Engine is busy with calculating the loop\nbecause it is a BLOCKING TASK\n\nHowever, when we were fetching data\nfrom API, engine was able to console.log\n\nBecause engine does not fetch data actively,\nbut WAIT for the network response.\n\nSo, fetch is a NON-BLOCKING TASK.\n\nGenerally, any task that is not actually doing\nsomething, but assigning a CALLBACK will\nnot block the event loop.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Engine is busy with calculating the loop\nbecause it is a BLOCKING TASK\n\nHowever, when we were fetching data\nfrom API, engine was able to console.log\n\nBecause engine does not fetch data actively,\nbut WAIT for the network response.\n\nSo, fetch is a NON-BLOCKING TASK.\n\nGenerally, any task that is not actually doing\nsomething, but assigning a CALLBACK will\nnot block the event loop.",
      "autoResize": true,
      "lineHeight": 1.25
    },

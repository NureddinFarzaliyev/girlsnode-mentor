    {
      "id": "09meGwxLJBLted_g9Yerc",
      "type": "text",
      "x": 9532.608709957693,
      "y": 1782.866590504919,
      "width": 325.7833251953125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b56",
      "roundness": null,
      "seed": 1485261948,
      "version": 142,
      "versionNonce": 581768316,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775367367270,
      "link": null,
      "locked": false,
      "text": "If there is a heavy task inside a call stack,\nit will block the engine while being executed.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If there is a heavy task inside a call stack,\nit will block the engine while being executed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Xg-y-Oyt9p4uIEp6vbGp7",
      "type": "text",
      "x": 9525.018606853302,
      "y": 2111.2474566943665,
      "width": 310.51666259765625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b56V",
      "roundness": null,
      "seed": 92047300,
      "version": 671,
      "versionNonce": 387267068,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775367933361,
      "link": null,
      "locked": false,
      "text": "In the example, when we use 0 seconds of \ndelay instead of 3 seconds, it will still wait\nfor task3 to be completed.\n\nBecause if CALL STACK is not empty, it\ncannot execute the callback yet.\n\nTherefore, the callback will be added\nto TASK QUEUE, to stay there when\nit is time to be executed.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In the example, when we use 0 seconds of \ndelay instead of 3 seconds, it will still wait\nfor task3 to be completed.\n\nBecause if CALL STACK is not empty, it\ncannot execute the callback yet.\n\nTherefore, the callback will be added\nto TASK QUEUE, to stay there when\nit is time to be executed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DuAHYHwpIQHAp-JO53OXc",
      "type": "text",
      "x": 9934.817980538899,
      "y": 1887.9066604257994,
      "width": 4.183333396911621,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b57",
      "roundness": null,
      "seed": 1415156676,
      "version": 3,
      "versionNonce": 1678930628,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1775367719503,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PhoemZs2HPl_MQ2juJ47Z",
      "type": "text",
      "x": 9561.666404671256,
      "y": 2822.3815584179893,
      "width": 322.1499938964844,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b58",
      "roundness": null,
      "seed": 1991819588,
      "version": 156,
      "versionNonce": 1306283972,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775368460733,
      "link": null,
      "locked": false,
      "text": "Event Loop is responsible from moving tasks\nfrom TASK QUEUE to CALL STACK.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Event Loop is responsible from moving tasks\nfrom TASK QUEUE to CALL STACK.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sxc9-glJnJwkWql_eh6bj",
      "type": "text",
      "x": 9635.48409879172,
      "y": 3181.3845731392694,
      "width": 166.01666259765625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b59",
      "roundness": null,
      "seed": 1090998012,
      "version": 314,
      "versionNonce": 263617220,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775368561675,
      "link": null,
      "locked": false,
      "text": "Task Queue operates \nFirst in First Out - FIFO",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Task Queue operates \nFirst in First Out - FIFO",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3tsJW7KrTpbUPdyZsCkmA",
      "type": "text",
      "x": 9586.319778200872,
      "y": 3349.5992731462497,
      "width": 281.8999938964844,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5A",
      "roundness": null,
      "seed": 1324397564,
      "version": 506,
      "versionNonce": 127965380,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775368589416,
      "link": null,
      "locked": false,
      "text": "Task Queue - is for callbacks\nMicrotask Queue - is for promises\n\nIt gets priority over regular Task Queue",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Task Queue - is for callbacks\nMicrotask Queue - is for promises\n\nIt gets priority over regular Task Queue",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],

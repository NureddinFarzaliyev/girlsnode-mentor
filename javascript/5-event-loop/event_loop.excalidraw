    {
      "id": "Qb1dFb6IJVNkhXD_OsfQ7",
      "type": "text",
      "x": 9535.134915849496,
      "y": 682.8926361398068,
      "width": 276.5833435058594,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4t",

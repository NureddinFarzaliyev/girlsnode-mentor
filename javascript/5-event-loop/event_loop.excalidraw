      "type": "text",
      "x": 9531.64102666169,
      "y": 1307.8171331944582,
      "width": 319.3666687011719,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
